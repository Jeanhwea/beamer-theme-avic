%% beamerthemeAvic.sty — AVIC beamer 主题
%% 引擎：XeLaTeX。选项详见 README.md。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAvic}[2026/08/02 v0.2 AVIC beamer theme]

\mode<presentation>

%% 依赖
\RequirePackage{graphicx}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{tikz}
\usetikzlibrary{calc, shapes.geometric}

%% keyval 族名，供 \avicset 复用
\edef\avic@family{\@currname}

%% 内部工具
%% 按名字查表执行，查不到则报错
\newcommand{\avic@dispatch}[4]{%
  \@ifundefined{avic@#1@#2}%
    {\PackageError{beamerthemeAvic}{Unknown #3 `#2'}{#4}}%
    {\csname avic@#1@#2\endcsname}}

%% 布尔选项赋值，顺带校验取值
\newcommand{\avic@setbool}[2]{%
  \@ifundefined{avic@#1#2}%
    {\PackageError{beamerthemeAvic}
      {Invalid value `#2' for option `#1'}
      {布尔选项只接受 true 或 false。}}%
    {\csname avic@#1#2\endcsname}}

%% 从候选表挑第一款已安装的字体，全缺则退回第一个并告警
\newif\ifavic@fontfound
\def\avic@firstitem#1,#2\avic@stop{\def\avic@fontdefault{#1}}
\newcommand*{\avic@pickfont}[2]{%
  \avic@firstitem#2,\avic@stop
  \let#1\avic@fontdefault
  \avic@fontfoundfalse
  \@for\avic@fontcand:=#2\do{%
    \ifavic@fontfound\else
      \IfFontExistsTF{\avic@fontcand}{\let#1\avic@fontcand\avic@fontfoundtrue}{}%
    \fi}%
  \ifavic@fontfound\else
    \PackageWarning{beamerthemeAvic}
      {候选字体均未安装 (#2)，退回 #1}%
  \fi}

\newcommand*{\avic@setfont}[2]{\expandafter#1\expandafter{#2}}
\newcommand*{\avic@setcjkfont}[1]{%
  \expandafter#1\expandafter{\avic@cjkfont}[AutoFakeSlant]}

%% 选项
\providecommand{\avicthemepath}{}
\newcommand{\avic@variant}{blue}
\newcommand{\avic@header}{gradient}
\newcommand{\avic@brandcn}{中国航空制造技术研究院}
\newcommand{\avic@branden}{AVIC MANUFACTURING TECHNOLOGY INSTITUTE}
\newcommand{\avic@security}{公开}
\newcommand{\avic@agenda}{汇\\报\\内\\容}
\newcommand{\avic@closingtext}{汇报完毕}
\newif\ifavic@sectionpage
\newif\ifavic@closingpage
\newif\ifavic@cjkdate

\DeclareOptionBeamer{color}{\renewcommand{\avic@variant}{#1}}
\DeclareOptionBeamer{header}{\renewcommand{\avic@header}{#1}}
\DeclareOptionBeamer{brandcn}{\renewcommand{\avic@brandcn}{#1}}
\DeclareOptionBeamer{branden}{\renewcommand{\avic@branden}{#1}}
\DeclareOptionBeamer{security}{\renewcommand{\avic@security}{#1}}
\DeclareOptionBeamer{agenda}{\renewcommand{\avic@agenda}{#1}}
\DeclareOptionBeamer{closing}{\renewcommand{\avic@closingtext}{#1}}
\DeclareOptionBeamer{assets}{\renewcommand{\avicthemepath}{#1}}
\DeclareOptionBeamer{sectionpage}[true]{\avic@setbool{sectionpage}{#1}}
\DeclareOptionBeamer{closingpage}[true]{\avic@setbool{closingpage}{#1}}
\DeclareOptionBeamer{cjkdate}[true]{\avic@setbool{cjkdate}{#1}}
\ExecuteOptionsBeamer{color=blue, header=gradient,
  sectionpage=true, closingpage=true, cjkdate=true}
\ProcessOptionsBeamer

%% 字体
\usefonttheme{professionalfonts}

\avic@pickfont{\avic@latinfont}{Arial,Helvetica,Liberation Sans,Nimbus Sans}
\avic@pickfont{\avic@monofont}{Courier New,Menlo,DejaVu Sans Mono,Liberation Mono}
\avic@pickfont{\avic@cjkfont}%
  {Microsoft YaHei,PingFang SC,Heiti SC,Noto Sans CJK SC,Source Han Sans SC,SimHei}

\avic@setfont{\setmainfont}{\avic@latinfont}
\avic@setfont{\setsansfont}{\avic@latinfont}
\avic@setfont{\setmonofont}{\avic@monofont}
\avic@setcjkfont{\setCJKmainfont}
\avic@setcjkfont{\setCJKsansfont}
\avic@setcjkfont{\setCJKmonofont}

\newcommand{\avictoday}{\number\year 年\number\month 月\number\day 日}
\ifavic@cjkdate\date{\avictoday}\fi

%% beamer 基础模板
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}[circle]
\setbeamertemplate{enumerate subitem}[circle]
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=-0.70ex]
    \node[circle, fill=themecolor, text=white, inner sep=1pt,
      minimum size=0.6em, font=\footnotesize\bfseries] {\insertenumlabel};%
}
\setcounter{tocdepth}{1}

%% 子模块
\RequirePackage{avic-colors}
\RequirePackage{avic-layout}
\RequirePackage{avic-templates}

\mode<all>
