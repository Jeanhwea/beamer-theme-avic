%% =====================================================================
%%  beamerthemeAvic.sty —— AVIC beamer 主题宏包（蓝 / 红双配色）
%%
%%  用法：
%%    1. TEXINPUTS 指向本宏包目录（素材与 .sty 同级）
%%    2. \usetheme[color=blue]{Avic} 或 \usetheme[color=red]{Avic}
%%    3. 正文只写内容，封面 / 章节页 / 结束页自动生成
%%
%%  选项：
%%    color=blue|red         配色与配套素材，默认 blue
%%    brandcn=<文字>         封面右上单位中文名，默认 中国航空制造技术研究院
%%    branden=<文字>         封面右上单位英文名，自动缩放至中文名同宽
%%    security=<文字>        封面密级标识，默认 公开，置空则不显示
%%    agenda=<文字>          章节页竖排标题，默认 汇\\报\\内\\容
%%    closing=<文字>         结束页文字，默认 汇报完毕
%%    assets=<路径>          素材路径前缀，默认与 .sty 同目录
%%    sectionpage=true|false 每章前自动插入章节页，默认 true
%%    closingpage=true|false 文末自动插入结束页，默认 true
%%    cjkdate=true|false     默认日期用中文格式，默认 true
%%
%%  新增配色只需增加 \avic@palette@<名称> 与对应的 -<名称> 素材。
%%
%%  本宏包只加载渲染自身所需的宏包；amsmath / booktabs / tabularx /
%%  fontawesome5 等内容宏包由文档自行加载。
%%
%%  1.依赖  2.选项  3.配色  4.素材  5.字体  6.beamer 基础  7.版式参数
%%  8.图元  9.封面  10.章节页  11.内页标题带  12.页码  13.结束页
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAvic}[2026/08/02 v3.0 AVIC beamer theme]

\mode<presentation>

%% =====================================================================
%%  1. 依赖宏包
%% =====================================================================
\RequirePackage{graphicx}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{tikz}
\usetikzlibrary{calc, shapes.geometric}

%% =====================================================================
%%  2. 选项
%% =====================================================================
\providecommand{\avicthemepath}{}
\newcommand{\avic@variant}{blue}
\newcommand{\avic@brandcn}{中国航空制造技术研究院}
\newcommand{\avic@branden}{AVIC MANUFACTURING TECHNOLOGY INSTITUTE}
\newcommand{\avic@security}{公开}
\newcommand{\avic@agenda}{汇\\报\\内\\容}
\newcommand{\avic@closingtext}{汇报完毕}
\newif\ifavic@sectionpage
\newif\ifavic@closingpage
\newif\ifavic@cjkdate

\DeclareOptionBeamer{color}{\renewcommand{\avic@variant}{#1}}
\DeclareOptionBeamer{brandcn}{\renewcommand{\avic@brandcn}{#1}}
\DeclareOptionBeamer{branden}{\renewcommand{\avic@branden}{#1}}
\DeclareOptionBeamer{security}{\renewcommand{\avic@security}{#1}}
\DeclareOptionBeamer{agenda}{\renewcommand{\avic@agenda}{#1}}
\DeclareOptionBeamer{closing}{\renewcommand{\avic@closingtext}{#1}}
\DeclareOptionBeamer{assets}{\renewcommand{\avicthemepath}{#1}}
\DeclareOptionBeamer{sectionpage}[true]{\csname avic@sectionpage#1\endcsname}
\DeclareOptionBeamer{closingpage}[true]{\csname avic@closingpage#1\endcsname}
\DeclareOptionBeamer{cjkdate}[true]{\csname avic@cjkdate#1\endcsname}
\ExecuteOptionsBeamer{color=blue, sectionpage=true, closingpage=true, cjkdate=true}
\ProcessOptionsBeamer

%% =====================================================================
%%  3. 配色
%% =====================================================================
\definecolor{avicblue}{RGB}{0,137,207}
\definecolor{avicred}{RGB}{191,1,1}
\definecolor{avicgray}{RGB}{242,242,242}
\definecolor{avicfootgray}{RGB}{89,89,89}
\definecolor{avictocgray}{RGB}{173,170,170}
\definecolor{avicconn}{RGB}{166,166,166}
\definecolor{avicorange}{RGB}{197,90,17}

\newcommand{\avic@palette@blue}{\colorlet{themecolor}{avicblue}}
\newcommand{\avic@palette@red}{\colorlet{themecolor}{avicred}}

\@ifundefined{avic@palette@\avic@variant}
  {\PackageError{beamerthemeAvic}
    {Unknown color variant `\avic@variant'}
    {可用值为 blue 或 red，或自行定义 \string\avic@palette@<名称>。}}
  {\csname avic@palette@\avic@variant\endcsname}

\colorlet{avicaccent}{themecolor}
\colorlet{avicbandbg}{white}
\colorlet{avicrule}{avicaccent}
\colorlet{avicsidebarbg}{avicgray}
\colorlet{avicbadgeon}{themecolor}
\colorlet{avicbadgeoff}{avictocgray}
\colorlet{avictocline}{avicconn}
\colorlet{aviccovertext}{white}

\setbeamercolor{structure}{fg=themecolor}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{background canvas}{bg=avicgray}
\setbeamercolor{titlelike}{fg=themecolor}
\setbeamercolor{frametitle}{fg=themecolor}
\setbeamercolor{alerted text}{fg=avicorange}
\setbeamercolor{itemize item}{fg=themecolor}
\setbeamercolor{itemize subitem}{fg=avicaccent}
\setbeamercolor{enumerate item}{fg=themecolor}
\setbeamercolor{description item}{fg=themecolor}
\setbeamercolor{item projected}{bg=themecolor, fg=white}
\setbeamercolor{subitem projected}{bg=avicaccent, fg=white}
\setbeamercolor{block title}{bg=themecolor, fg=white}
\setbeamercolor{block body}{bg=white, fg=black}
\setbeamercolor{block title alerted}{bg=avicorange, fg=white}
\setbeamercolor{block body alerted}{bg=white, fg=black}
\setbeamercolor{block title example}{bg=avicconn, fg=white}
\setbeamercolor{block body example}{bg=white, fg=black}
\setbeamercolor{caption name}{fg=themecolor}
\setbeamercolor{page number in head/foot}{fg=avicfootgray}

%% =====================================================================
%%  4. 素材 —— 文件名随配色变体展开，白色徽标为双色共用
%%     \aviccoverbg / \avicwatermark / \avicframelogo / \avicwhitelogo
%%     为公开路径宏，正文可直接 \includegraphics 复用
%% =====================================================================
\edef\aviccoverbg{\avicthemepath thm-cover-bg-\avic@variant.png}
\edef\avicwatermark{\avicthemepath thm-avic-logo-\avic@variant.png}
\edef\avicframelogo{\avicthemepath thm-frame-logo-\avic@variant.pdf}
\edef\avicwhitelogo{\avicthemepath thm-avic-logo-white.png}

%% =====================================================================
%%  5. 字体 —— 西文走 fontspec，中文走 xeCJK，缺字体时逐级回退
%% =====================================================================
\usefonttheme{professionalfonts}

\newcommand{\avic@latinfont}{Arial}
\newcommand{\avic@monofont}{Courier New}
\newcommand{\avic@cjkfont}{Microsoft YaHei}

\IfFontExistsTF{\avic@latinfont}{}{\renewcommand{\avic@latinfont}{Helvetica}}
\IfFontExistsTF{\avic@monofont}{}{\renewcommand{\avic@monofont}{Menlo}}
\IfFontExistsTF{\avic@cjkfont}{}{%
  \renewcommand{\avic@cjkfont}{PingFang SC}%
  \IfFontExistsTF{\avic@cjkfont}{}{\renewcommand{\avic@cjkfont}{Heiti SC}}}

\expandafter\setmainfont\expandafter{\avic@latinfont}
\expandafter\setsansfont\expandafter{\avic@latinfont}
\expandafter\setmonofont\expandafter{\avic@monofont}
\expandafter\setCJKmainfont\expandafter{\avic@cjkfont}[AutoFakeSlant]
\expandafter\setCJKsansfont\expandafter{\avic@cjkfont}[AutoFakeSlant]
\expandafter\setCJKmonofont\expandafter{\avic@cjkfont}[AutoFakeSlant]

\newcommand{\avictoday}{\the\year 年\the\month 月\the\day 日}
\ifavic@cjkdate\date{\avictoday}\fi

%% =====================================================================
%%  6. beamer 基础 —— 列表与导航模板
%% =====================================================================
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}[circle]
\setbeamertemplate{enumerate subitem}[circle]
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=-0.70ex]
    \node[circle, fill=themecolor, text=white, inner sep=1pt,
      minimum size=0.6em, font=\footnotesize\bfseries] {\insertenumlabel};%
}
\setcounter{tocdepth}{1}

%% =====================================================================
%%  7. 版式参数 —— \avic@*frac 为占页面宽度的比例，其余为绝对尺寸
%% =====================================================================
\newcommand*{\avic@sidebarfrac}{0.115}
\newcommand*{\avic@arrowtipfrac}{0.305}
\newcommand*{\avic@tocrulefrac}{0.93}
\newcommand*{\avic@bandht}{1.18cm}
\newcommand*{\avic@logoht}{0.80cm}
\newcommand*{\avic@coverlogoht}{6.6cm}
\newcommand*{\avic@brandlogoht}{0.72cm}
\newcommand*{\avic@brandcnpt}{10.5}
\newcommand*{\avic@brandenpt}{5}
\newcommand*{\avic@brandtextratio}{0.706}
\newcommand*{\avic@brandleadratio}{0.31}
\newcommand*{\avic@brandgapratio}{0.115}

%% =====================================================================
%%  8. 图元 —— 各页面复用的构件
%% =====================================================================

%% 单位名称：英文名缩放至与中文名同宽，行距取中文名高度的
%% \avic@brandleadratio 倍，两行整体缩放到徽标高度的 \avic@brandtextratio 倍
%% 比例取自原 thm-avic-mti-full.png 的像素实测：徽标 445，中文 192，
%% 行距 56，英文 70，文字总高 318
\newsavebox{\avic@brandcnbox}
\newsavebox{\avic@brandenbox}
\newlength{\avic@brandlead}
\newlength{\avic@brandtextht}
\newlength{\avic@brandgapln}
\setlength{\avic@brandgapln}{\avic@brandlogoht}
\setlength{\avic@brandgapln}{\avic@brandgapratio\avic@brandgapln}
\newcommand{\avic@brandtext}{%
  \sbox\avic@brandcnbox{%
    \bfseries\fontsize{\avic@brandcnpt}{\avic@brandcnpt}\selectfont\avic@brandcn}%
  \sbox\avic@brandenbox{%
    \resizebox{\wd\avic@brandcnbox}{!}{%
      \bfseries\fontsize{\avic@brandenpt}{\avic@brandenpt}\selectfont\avic@branden}}%
  \dp\avic@brandenbox=\z@
  \setlength{\avic@brandlead}{\avic@brandleadratio\ht\avic@brandcnbox}%
  \setlength{\avic@brandtextht}{\avic@brandlogoht}%
  \setlength{\avic@brandtextht}{\avic@brandtextratio\avic@brandtextht}%
  \resizebox{!}{\avic@brandtextht}{%
    \vbox{\offinterlineskip
      \hbox{\usebox\avic@brandcnbox}%
      \vskip\avic@brandlead
      \hbox{\usebox\avic@brandenbox}}}%
}

%% 封面/结束页背景：铺底图 + 左下水印徽标 + 右上白色徽标与单位名称
\newcommand{\avic@coverscene}{%
  \node[anchor=center, inner sep=0pt] at (current page.center)
    {\includegraphics[width=\paperwidth, height=\paperheight]{\aviccoverbg}};
  \node[anchor=center, inner sep=0pt]
    at ([xshift=2.2cm, yshift=2.0cm]current page.south west)
    {\includegraphics[height=\avic@coverlogoht]{\avicwatermark}};
  \node[anchor=north east, inner sep=0pt, text=aviccovertext] (avicbrand)
    at ([xshift=-0.55cm, yshift=-0.45cm]current page.north east) {\avic@brandtext};
  \node[anchor=east, inner sep=0pt] at ([xshift=-\avic@brandgapln]avicbrand.west)
    {\includegraphics[height=\avic@brandlogoht]{\avicwhitelogo}};%
}

%% 内页右上角小 logo
\newcommand{\avic@brandlogo}{%
  \includegraphics[height=\avic@logoht]{\avicframelogo}%
}

%% 密级标识（封面左上角），选项置空则不绘制
\newcommand{\avic@secmark}{%
  \ifx\avic@security\@empty\else
    \node[anchor=north west, text=aviccovertext, font=\large, inner sep=0pt]
      at ([xshift=1.0cm, yshift=-0.5cm]current page.north west) {\avic@security};%
  \fi
}

%% 目录徽标（平行四边形）
\tikzset{avicbadge/.style={
    trapezium, trapezium left angle=66, trapezium right angle=114,
    text=white, font=\footnotesize\bfseries,
    minimum width=0.62cm, minimum height=0.46cm, inner sep=0pt, outer sep=0pt}}

%% =====================================================================
%%  9. 封面 —— 铺图背景 + 居中白色标题 / 作者 / 单位 / 日期
%% =====================================================================
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \avic@coverscene
    \avic@secmark
    \node[anchor=center, text=aviccovertext, align=center,
      font=\fontsize{30}{38}\bfseries\selectfont]
      at ([yshift=1.05cm]current page.center) {\inserttitle};
    \node[anchor=center, text=aviccovertext, align=center, font=\normalsize]
      at ([yshift=-1.15cm]current page.center) {\insertauthor};
    \node[anchor=center, text=aviccovertext, align=center, font=\normalsize]
      at ([yshift=-1.85cm]current page.center) {\insertinstitute};
    \node[anchor=center, text=aviccovertext, align=center, font=\normalsize]
      at ([yshift=-2.55cm]current page.center) {\insertdate};
  \end{tikzpicture}%
}

%% =====================================================================
%%  10. 章节页 —— section page 模板，每章前自动插入
%% =====================================================================
\providecommand*{\beamer@sectionmax}{1}
\newcounter{avictoc}

%% 单项（绝对定位，徽标落在 > 折线上）：#1 徽标色 #2 名称选项 #3 对齐线色
%% 位置由总章节数 \beamer@sectionmax 等距计算：
%%   - n<=3 跨度 0.44（紧凑），n=4 跨度 0.50，n>=5 跨度 0.60
%%   - 整体相对页面垂直中心 0.5 对称分布
%%   - x 跟随 V 形折线（顶点 \avic@arrowtipfrac，两端 \avic@sidebarfrac）
\newcommand{\avic@tocitem}[3]{%
  \stepcounter{avictoc}%
  \pgfmathsetmacro{\avic@total}{max(\beamer@sectionmax, 1)}%
  \pgfmathsetmacro{\avic@span}{%
    ifthenelse(\avic@total<=3, 0.44, ifthenelse(\avic@total==4, 0.50, 0.60))}%
  \pgfmathsetmacro{\avic@step}{\avic@span / max(\avic@total - 1, 1)}%
  \pgfmathsetmacro{\avic@tocy}{0.5 + (\value{avictoc} - (\avic@total + 1) / 2) * \avic@step}%
  \pgfmathsetmacro{\avic@tocx}{\avic@sidebarfrac
    + (\avic@arrowtipfrac - \avic@sidebarfrac) * (1 - abs(2 * \avic@tocy - 1))}%
  \begin{tikzpicture}[remember picture, overlay]
    \node[avicbadge, fill=#1, anchor=center] (num)
      at ([xshift=\avic@tocx\paperwidth, yshift=-\avic@tocy\paperheight]current page.north west)
      {\inserttocsectionnumber};
    \node[#2] (nm) at ([xshift=0.28cm]num.east) {\inserttocsection};
    \coordinate (ls) at ([yshift=-0.42cm]nm.west);
    \coordinate (le) at ([xshift=\avic@tocrulefrac\paperwidth]current page.north west);
    \draw[#3, line width=0.3pt] (ls) -- (ls -| le);
  \end{tikzpicture}%
}
\setbeamertemplate{section in toc}{%
  \avic@tocitem{avicbadgeon}{anchor=west, font=\large\bfseries, text=themecolor}{avictocline}}
\setbeamertemplate{section in toc shaded}{%
  \avic@tocitem{avicbadgeoff}{anchor=west, font=\large, text=black}{avictocline!70}}

%% 装饰：浅灰侧边栏 + 灰色右指箭头(主题色描边) + 竖排标题 + 右上 logo
\newcommand{\avicagendadecor}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[white] (current page.north west) rectangle (current page.south east);
    \fill[avicsidebarbg] (current page.north west) rectangle
      ([xshift=\avic@sidebarfrac\paperwidth]current page.south west);
    \fill[avicsidebarbg]
      ([xshift=\avic@sidebarfrac\paperwidth]current page.north west) --
      ([xshift=\avic@arrowtipfrac\paperwidth, yshift=-0.50\paperheight]current page.north west) --
      ([xshift=\avic@sidebarfrac\paperwidth, yshift=-\paperheight]current page.north west) -- cycle;
    \draw[avicrule, line width=0.4pt]
      ([xshift=\avic@sidebarfrac\paperwidth]current page.north west) --
      ([xshift=\avic@arrowtipfrac\paperwidth, yshift=-0.50\paperheight]current page.north west) --
      ([xshift=\avic@sidebarfrac\paperwidth, yshift=-\paperheight]current page.north west);
    \node[anchor=center, text=themecolor, align=center,
      font=\fontsize{32}{40}\bfseries\selectfont, inner sep=0pt]
      at ([xshift=0.085\paperwidth, yshift=-0.50\paperheight]current page.north west) {#1};
    \node[anchor=north east, inner sep=0pt]
      at ([xshift=-0.50cm, yshift=-0.40cm]current page.north east) {\avic@brandlogo};
  \end{tikzpicture}%
}

\setbeamertemplate{section page}{%
  \avicagendadecor{\avic@agenda}%
  \setcounter{avictoc}{0}%
  \tableofcontents[currentsection, hideallsubsections]%
}

\ifavic@sectionpage
  \AtBeginSection[]{\frame{\sectionpage}}
\fi

%% =====================================================================
%%  11. 内页标题带 —— 白色标题带 + 主题色加粗标题 + 全宽分隔线 + 右上 logo
%% =====================================================================
\setbeamertemplate{frametitle}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[avicbandbg] (current page.north west)
      rectangle ([yshift=-\avic@bandht]current page.north east);
    \node[anchor=west, text=themecolor, font=\Large\bfseries, inner sep=0pt]
      at ([xshift=0.70cm, yshift=-0.57cm]current page.north west) {\insertframetitle};
    \draw[avicrule, line width=0.4pt]
      ([yshift=-\avic@bandht]current page.north west) --
      ([yshift=-\avic@bandht]current page.north east);
    \node[anchor=east, inner sep=0pt]
      at ([xshift=-0.60cm, yshift=-0.57cm]current page.north east) {\avic@brandlogo};
  \end{tikzpicture}%
  \rule{0pt}{\avic@bandht}%
}

%% =====================================================================
%%  12. 页码 —— 右下角灰色，首页不显示；结束页在 \appendix 之后，
%%      不计入 \inserttotalframenumber
%% =====================================================================
\setbeamertemplate{footline}{%
  \ifnum\insertframenumber=1\relax\else
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=south east, text=avicfootgray, font=\scriptsize, inner sep=0pt]
        at ([xshift=-0.45cm, yshift=0.3cm]current page.south east)
        {\insertframenumber\,/\,\inserttotalframenumber};
    \end{tikzpicture}%
  \fi
}

%% =====================================================================
%%  13. 结束页 —— 文档末尾自动插入；铺图背景 + 大号白字
%% =====================================================================
\newcommand{\avicclosing}[1][\avic@closingtext]{%
  \begin{tikzpicture}[remember picture, overlay]
    \avic@coverscene
    \node[anchor=center, text=aviccovertext, inner sep=0pt,
      font=\fontsize{40}{48}\bfseries\selectfont] at (current page.center) {#1};
  \end{tikzpicture}%
}

%% pandoc 默认传 ignorenonframetext，会让 \AtEndDocument 插入的帧无法输出
\beamer@ignorenonframefalse

%% footline 必须在 \frame 之前清空，帧 shipout 时模板已锁定
\ifavic@closingpage
  \AtEndDocument{%
    \appendix
    \setbeamertemplate{footline}{}%
    \frame{\avicclosing}%
  }
\fi

\mode<all>
